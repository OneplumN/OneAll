{
  "name": "oneall-antd-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "audit:ui": "node scripts/audit-ui.mjs",
    "acceptance:browser": "node scripts/acceptance-browser.mjs",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --experimental-strip-types --test tests/*.unit.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/*.integration.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "playwright": "^1.60.0",
    "typescript": "^5.7.2"
  }
}
